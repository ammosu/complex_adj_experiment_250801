# 住宅社區調整率分析系統 - 環境變數配置示例
# 複製此文件為 .env 並設定您的實際值

# ===========================================
# 數據源配置
# ===========================================

# 主要數據源 URL (CSV檔案位置) - 請替換為您的實際URL
HOUSING_DATA_URL=https://your-bucket.s3.amazonaws.com/path/to/complex_ids.csv

# 可選：備用數據源
# HOUSING_DATA_BACKUP_URL=https://backup-location.com/complex_ids.csv

# ===========================================
# 部署平台特定配置
# ===========================================

# Vercel 部署設定
# 在 Vercel Dashboard -> Settings -> Environment Variables 中設定：
# HOUSING_DATA_URL = 您的S3 URL

# Netlify 部署設定  
# 在 Netlify Dashboard -> Site Settings -> Environment Variables 中設定：
# HOUSING_DATA_URL = 您的S3 URL

# Render 部署設定
# 在 Render Dashboard -> Environment 中設定：
# HOUSING_DATA_URL = 您的S3 URL

# ===========================================
# 本地開發配置
# ===========================================

# 本地開發時可以設定為本地檔案路徑
# HOUSING_DATA_URL=./data_backup/complex_ids.csv

# 或使用不同的遠端位置進行測試
# HOUSING_DATA_URL=https://your-test-bucket.s3.amazonaws.com/test_data.csv